    "icon": "tauri icon build/icon.svg",
    "tauri": "tauri",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "pdfjs-dist": "^6.3.289"
  }
}
