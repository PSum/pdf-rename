{
  "name": "pdf-rename",
  "productName": "PDF Rename",
  "version": "0.3.1",
  "description": "Keyboard-driven batch PDF renamer",
  "author": "Philipp Sum <sum.philipp@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
